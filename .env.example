# ============================================================================
# InstaMind AI — environment template
#
#   cp .env.example .env      then fill in the values.
#
# NEVER commit .env. Every secret below is required in production; the API
# refuses to boot with an insecure configuration (see app/core/config.py).
# Generate secrets with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# ============================================================================

# ---------------------------------------------------------------- application
INSTAMIND_APP_ENV=development
INSTAMIND_DEBUG=true
INSTAMIND_LOG_LEVEL=INFO
INSTAMIND_LOG_JSON=false
PUBLIC_URL=http://localhost
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------- security
# JWT signing key. 32+ characters. Rotate with a dual-key rollout.
INSTAMIND_SECRET_KEY=change-me-please-use-secrets-token-urlsafe
# Fernet master key for encrypting Meta tokens at rest. MUST differ from
# SECRET_KEY so a JWT leak cannot decrypt stored credentials.
INSTAMIND_TOKEN_ENCRYPTION_KEY=change-me-too-please-use-a-different-secret

# Argon2id parameters (increase as hardware allows).
INSTAMIND_ARGON2_TIME_COST=3
INSTAMIND_ARGON2_MEMORY_COST_KIB=65536
INSTAMIND_ARGON2_PARALLELISM=2

INSTAMIND_ACCESS_TOKEN_TTL_MINUTES=15
INSTAMIND_REFRESH_TOKEN_TTL_DAYS=30
INSTAMIND_REFRESH_TOKEN_MAX_AGE_DAYS=90

# ------------------------------------------------------------------- database
INSTAMIND_DATABASE_URL=postgresql+asyncpg://instamind:instamind@localhost:5432/instamind
INSTAMIND_DB_POOL_SIZE=10
INSTAMIND_DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------- redis/queue
INSTAMIND_REDIS_URL=redis://localhost:6379/0
INSTAMIND_CELERY_BROKER_URL=redis://localhost:6379/1
INSTAMIND_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -------------------------------------------------------------------- storage
INSTAMIND_STORAGE_BACKEND=s3
INSTAMIND_LOCAL_STORAGE_ROOT=./storage
INSTAMIND_S3_ENDPOINT_URL=http://localhost:9000
INSTAMIND_S3_REGION=us-east-1
INSTAMIND_S3_BUCKET=instamind
INSTAMIND_S3_ACCESS_KEY=instamind
INSTAMIND_S3_SECRET_KEY=instamind-dev-secret
# Meta fetches media from this base URL, so it must be publicly reachable.
INSTAMIND_PUBLIC_MEDIA_BASE_URL=http://localhost/media
INSTAMIND_MAX_UPLOAD_BYTES=8388608
INSTAMIND_MAX_VIDEO_UPLOAD_BYTES=314572800

# --------------------------------------------------------------- Meta / IG API
# Two official auth paths are supported; configure the one(s) you use.
# See docs/instagram-integration.md for the exact App Review checklist.
META_APP_ID=
META_APP_SECRET=

# Instagram API with Instagram Login (no Facebook Page required)
META_IG_CLIENT_ID=
META_IG_CLIENT_SECRET=

# Instagram API with Facebook Login (requires a linked Facebook Page)
META_FB_CLIENT_ID=
META_FB_CLIENT_SECRET=

# Must match the Verify Token in the Meta App Dashboard webhook settings.
META_WEBHOOK_VERIFY_TOKEN=

INSTAMIND_META_API_VERSION=v23.0
# Our own guard below Meta's 50-100 posts/24h ceiling.
INSTAMIND_PUBLISH_DAILY_GUARD_LIMIT=100

# ------------------------------------------------------------------------- AI
# "null" disables generation (the API then returns a clear 503 instead of
# inventing content).
AI_PROVIDER=null
OPENAI_API_KEY=
INSTAMIND_OPENAI_MODEL=gpt-4o-mini
# Hard monthly AI budget per workspace, in USD cents.
INSTAMIND_AI_DEFAULT_MONTHLY_BUDGET_CENTS=2000

# -------------------------------------------------------------------- billing
BILLING_PROVIDER=null
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# --------------------------------------------------------------- mail / sms
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@instamind.ai
SMS_BACKEND=null
KAVENEGAR_API_KEY=

# ------------------------------------------------------------- observability
SENTRY_DSN=
INSTAMIND_METRICS_ENABLED=true

# --------------------------------------------------------------- bootstrap
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=
DEFAULT_PLAN_CODE=free
